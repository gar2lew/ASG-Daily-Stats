index 0000000..829a1de
--- /dev/null
+++ b/lib/admin.js
@@ -0,0 +1,47 @@
+// Admin PIN check for the rep admin panel. The PIN lives in the ADMIN_PIN env var, never in the page.
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+export const PIN_PATTERN = /^\d{4}$/;
+export const MAX_FAILED_ATTEMPTS = 5;
+export const LOCK_MS = 15 * 60 * 1000;
+
+// Wrong attempts per client. Each serverless instance keeps its own count, so this slows
+// guessing but does not stop it completely. A 4-digit PIN relies on this limit.
+const failures = new Map(); // client key -> { count, lockedUntil }
+
+export function clientKey(req) {
+  const forwarded = req.headers['x-forwarded-for'];
+  if (typeof forwarded === 'string' && forwarded.trim()) return forwarded.split(',')[0].trim();
+  return req.socket?.remoteAddress || 'unknown';
+}
+
+// Returns { ok } or { ok: false, status, error }. Each request must send the PIN in x-admin-pin.
+export function checkAdminPin(req, { now = Date.now(), expected = process.env.ADMIN_PIN } = {}) {
+  if (!expected || !PIN_PATTERN.test(expected)) {
+    return { ok: false, status: 500, error: 'ADMIN_PIN must be set to a 4-digit number' };
+  }
+
+  const key = clientKey(req);
+  const state = failures.get(key);
+  if (state && state.lockedUntil > now) {
+    return { ok: false, status: 429, error: 'Too many wrong PIN attempts. Try again in 15 minutes.' };
+  }
+
+  const given = req.headers['x-admin-pin'];
+  const matches = typeof given === 'string' && PIN_PATTERN.test(given) && timingSafeEqual(
+    createHash('sha256').update(given).digest(),
+    createHash('sha256').update(expected).digest(),
+  );
+  if (matches) {
+    failures.delete(key);
+    return { ok: true };
+  }
+
+  const count = (state?.count || 0) + 1;
+  if (count >= MAX_FAILED_ATTEMPTS) {
+    failures.set(key, { count: 0, lockedUntil: now + LOCK_MS });
+  } else {
+    failures.set(key, { count, lockedUntil: 0 });
+  }
+  return { ok: false, status: 401, error: 'Incorrect PIN' };
+}
diff --git a/lib/reps-store.js b/lib/reps-store.js
index 9176ab4..c4cda36 100644
--- a/lib/reps-store.js
+++ b/lib/reps-store.js
@@ -81,3 +81,58 @@ export async function addRep(sheets, spreadsheetId, input, today) {
     rep: { name: checked.name, state: checked.state, timezone: checked.timezone, active: true, added: today },
   };
 }
+
+// Every row for the admin panel, removed reps included. row is the sheet row number.
+export async function listAllReps(sheets, spreadsheetId) {
+  if (!(await tabExists(sheets, spreadsheetId))) return [];
+  const rows = await readRows(sheets, spreadsheetId);
+  return rows
+    .slice(1)
+    .map((row, i) => ({ row: i + 2, ...toRep(row) }))
+    .filter(rep => rep.name)
+    .sort((a, b) => a.name.localeCompare(b.name));
+}
+
+function httpError(message, status) {
+  const error = new Error(message);
+  error.status = status;
+  return error;
+}
+
+// Name, State and Timezone for one row. Refuses a name already used by another row.
+export async function saveRep(sheets, spreadsheetId, { row, name, state }) {
+  const checked = validateRepInput({ name, state });
+  if (!checked.ok) throw httpError(checked.error, 400);
+
+  const rows = await readRows(sheets, spreadsheetId);
+  const current = rows[row - 1];
+  if (!current || !(current[0] || '').trim()) throw httpError('That rep was not found', 404);
+
+  const key = checked.name.toLowerCase();
+  const clash = rows.slice(1).some((r, i) => i + 2 !== row && (r[0] || '').trim().toLowerCase() === key);
+  if (clash) throw httpError('Another rep already has that name', 409);
+
+  const active = (current[3] || '').trim().toUpperCase() !== 'FALSE';
+  await sheets.spreadsheets.values.update({
+    spreadsheetId,
+    range: `'${REPS_TAB}'!A${row}:D${row}`,
+    valueInputOption: 'RAW',
+    requestBody: { values: [[checked.name, checked.state, checked.timezone, active ? 'TRUE' : 'FALSE']] },
+  });
+  return { row, name: checked.name, state: checked.state, timezone: checked.timezone, active };
+}
+
+// Shows (active true) or hides (active false) a rep. The row and its history stay on the sheet.
+export async function setRepActive(sheets, spreadsheetId, { row, active }) {
+  const rows = await readRows(sheets, spreadsheetId);
+  const current = rows[row - 1];
+  if (!current || !(current[0] || '').trim()) throw httpError('That rep was not found', 404);
+
+  await sheets.spreadsheets.values.update({
+    spreadsheetId,
+    range: `'${REPS_TAB}'!D${row}`,
+    valueInputOption: 'RAW',
+    requestBody: { values: [[active ? 'TRUE' : 'FALSE']] },
+  });
+  return { ...toRep(current), row, active };
+}
